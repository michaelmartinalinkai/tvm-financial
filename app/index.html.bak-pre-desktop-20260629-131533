    <div class="s">Cost ${money(o.fullCost)}${o.dp?` (DP ${money(o.cost||0)})`:''} · Paid ${money(o.paid||0)}${o.out>0?` · <b>${money(o.out)} left</b>`:' · paid ✓'}</div></div>
